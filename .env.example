# ============================================================================
# BDCommerce environment variables
#
# Local development:
#   cp .env.example .env  (root, used by scripts)
#   cp .env.example apps/api/.dev.vars  (secrets for `wrangler dev`)
#
# Cloudflare deployment: set each variable in the Worker's Settings -> Variables
# and in the Pages projects' environment settings.
# ============================================================================

# ---------------------------------------------------------------------------
# API Worker (apps/api) — secrets live in apps/api/.dev.vars locally and in
# Cloudflare Worker variables/secrets in production.
# ---------------------------------------------------------------------------

# Used to sign JWTs. Generate one: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (default 30 days)
JWT_REFRESH_TTL=2592000

# Domain to scope auth cookies to. Leave empty on localhost.
# Use ".yourdomain.com" so all subdomains share the same auth cookie.
COOKIE_DOMAIN=

# Comma-separated list of allowed CORS origins (storefront + admin URLs).
# In production: https://yourstore.com,https://admin.yourstore.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8787

# Comma-separated allowlist for creating new admin accounts via
# POST /api/v1/admin/users (role=ADMIN). Optional; if empty, admin users can
# only be created by the bootstrap seed.
ADMIN_SIGNUP_KEY=

# Maximum failed logins per IP before a temporary lockout window.
RATE_LIMIT_MAX=100
# KV-backed rate limit window in seconds (rate limiting uses D1 when KV is absent)
RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------------------
# Storefront (apps/storefront) — build-time, inlined by Next.js
# ---------------------------------------------------------------------------

# Public URL of the deployed API Worker (e.g. https://api.yourstore.com)
# or http://localhost:8787 for local development.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public storefront URL (used for canonical URLs / sitemap / SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin (apps/admin) — build-time, inlined by Next.js
# ---------------------------------------------------------------------------

# Same API URL as above
NEXT_PUBLIC_API_URL=http://localhost:8787
