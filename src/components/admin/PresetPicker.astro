---
import { PRESETS } from '../../presets';
import { t } from '../../lib/i18n';
import type { AdminLocale } from '../../lib/admin-locale';

interface Props {
  locale: AdminLocale;
}

const { locale } = Astro.props;
const presets = PRESETS.map((preset) => ({
  id: preset.id,
  label: preset.label[locale] || preset.label.en,
  description: preset.description[locale] || preset.description.en,
}));
---

<section class="rounded-xl bg-white p-4 shadow-sm">
  <h2 class="text-lg font-semibold">{t(locale, 'admin.presets.title')}</h2>
  <p class="mt-1 text-sm text-slate-500">{t(locale, 'admin.presets.hint')}</p>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    {
      presets.map((preset) => (
        <div class="rounded-lg border border-slate-200 p-3">
          <p class="font-medium">{preset.label}</p>
          <p class="mt-1 text-xs text-slate-500">{preset.description}</p>
          <button
            type="button"
            class="js-preset mt-3 rounded bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 disabled:opacity-60"
            data-preset={preset.id}
            data-confirm={t(locale, 'admin.presets.confirm', { name: preset.label })}
            data-running={t(locale, 'admin.presets.running')}
            data-failed={t(locale, 'admin.presets.failed')}
          >
            {t(locale, 'admin.presets.apply')}
          </button>
        </div>
      ))
    }
  </div>
  <p id="preset-status" class="mt-2 hidden text-sm" aria-live="polite"></p>
</section>

<script>
  const status = document.getElementById('preset-status');

  document.querySelectorAll<HTMLButtonElement>('.js-preset').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!window.confirm(button.dataset.confirm ?? '')) return;
      button.disabled = true;
      if (status) {
        status.textContent = button.dataset.running ?? '';
        status.className = 'mt-2 text-sm text-slate-600';
        status.classList.remove('hidden');
      }

      try {
        const response = await fetch('/api/admin/presets/apply', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ preset: button.dataset.preset }),
        });
        const payload = (await response.json().catch(() => null)) as {
          ok?: boolean;
          data?: { categories: number; products: number; variants: number };
        } | null;

        if (!response.ok || !payload?.ok) {
          if (status) {
            status.textContent = button.dataset.failed ?? '';
            status.className = 'mt-2 text-sm text-rose-700';
          }
          button.disabled = false;
          return;
        }

        if (status) {
          status.textContent = `+${payload.data?.categories ?? 0} / +${payload.data?.products ?? 0} / +${payload.data?.variants ?? 0}`;
          status.className = 'mt-2 text-sm text-emerald-700';
        }
        window.setTimeout(() => window.location.reload(), 800);
      } catch {
        if (status) {
          status.textContent = button.dataset.failed ?? '';
          status.className = 'mt-2 text-sm text-rose-700';
        }
        button.disabled = false;
      }
    });
  });
</script>
