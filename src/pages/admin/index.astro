---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { resolveAdminLocale } from '../../lib/admin-locale';
import { loadAdminDashboard } from '../../lib/admin-dashboard';
import { loadStorefront } from '../../lib/storefront';
import { formatBdt } from '../../lib/money';
import { t } from '../../lib/i18n';
import { countRoundTrips, logQueryCount } from '../../lib/query-log';

const requested = Astro.url.searchParams.get('lang');
if (requested === 'bn' || requested === 'en') {
  Astro.cookies.set('admin_locale', requested, {
    path: '/',
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
  });
}
const locale = resolveAdminLocale(requested, Astro.cookies.get('admin_locale')?.value);

const { value: db, count } = countRoundTrips(env.DB);
const { config, setupCompleted } = await loadStorefront(db);
const dashboard = await loadAdminDashboard(db, new Date(), config.inventory.lowStockThreshold);

if (!setupCompleted) {
  // Only a first-run shop pays for this extra existence check; an existing
  // catalog is never forced through the wizard.
  const catalog = await db
    .prepare(
      `SELECT EXISTS(SELECT 1 FROM products LIMIT 1) AS has_products,
              EXISTS(SELECT 1 FROM categories LIMIT 1) AS has_categories`,
    )
    .first<{ has_products: number; has_categories: number }>();
  if (!catalog?.has_products && !catalog?.has_categories) {
    return Astro.redirect('/admin/setup');
  }
}

logQueryCount('admin/dashboard', count());

const money = (amount: number) =>
  formatBdt(amount, {
    locale,
    symbol: config.currency.symbol,
    bnDigits: config.currency.bnDigits,
  });

const cards = [
  {
    label: t(locale, 'admin.dashboardCards.todayOrders'),
    value: String(dashboard.todayOrders),
    href: '/admin/orders',
  },
  {
    label: t(locale, 'admin.dashboardCards.pendingOrders'),
    value: String(dashboard.pendingOrders),
    href: '/admin/orders?status=pending',
  },
  {
    label: t(locale, 'admin.dashboardCards.weekRevenue'),
    value: money(dashboard.weekRevenue),
    href: '/admin/orders',
    hint: t(locale, 'admin.dashboardCards.weekHint'),
  },
  {
    label: t(locale, 'admin.dashboardCards.cashCollected'),
    value: money(dashboard.weekCashCollected),
    href: '/admin/orders',
    hint: t(locale, 'admin.dashboardCards.cashHint'),
  },
  {
    label: t(locale, 'admin.dashboardCards.lowStock'),
    value: String(dashboard.lowStockCount),
    href: '/admin/products',
    hint: t(locale, 'admin.dashboardCards.lowStockHint', {
      count: config.inventory.lowStockThreshold,
    }),
  },
];
---

<AdminLayout title={t(locale, 'admin.dashboard')} locale={locale} current="dashboard">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">{t(locale, 'admin.welcome')}</h1>
    <a
      href="/admin/orders?status=pending"
      class="rounded bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800"
    >
      {t(locale, 'admin.dashboardCards.viewPending')}
    </a>
  </div>

  {!setupCompleted && (
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
      <span>{t(locale, 'admin.setup.pending')}</span>
      <a href="/admin/setup" class="rounded bg-amber-900 px-3 py-2 font-medium text-white">
        {t(locale, 'admin.setup.open')}
      </a>
    </div>
  )}

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="rounded-xl bg-white p-5 shadow-sm transition hover:shadow"
        >
          <span class="block text-sm text-slate-500">{card.label}</span>
          <span class="mt-1 block text-2xl font-semibold text-teal-800">{card.value}</span>
          {card.hint && <span class="mt-1 block text-xs text-slate-400">{card.hint}</span>}
        </a>
      ))
    }
  </div>

  <section class="mt-6 rounded-xl bg-white p-5 shadow-sm">
    <h2 class="text-lg font-semibold">{t(locale, 'admin.dashboardCards.lowStockTitle')}</h2>
    {
      dashboard.lowStock.length === 0 ? (
        <p class="mt-2 text-sm text-slate-500">{t(locale, 'admin.dashboardCards.noLowStock')}</p>
      ) : (
        <ul class="mt-3 divide-y divide-slate-100">
          {dashboard.lowStock.map((variant) => (
            <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
              <a
                href={`/admin/products/${variant.product_id}`}
                class="font-medium text-teal-700 hover:underline"
              >
                {locale === 'bn' && variant.title_bn ? variant.title_bn : variant.title}
              </a>
              <span class="text-slate-500">{variant.variant_title}</span>
              <span
                class:list={[
                  'rounded-full px-2 py-0.5 text-xs font-semibold',
                  variant.stock === 0
                    ? 'bg-rose-100 text-rose-900'
                    : 'bg-amber-100 text-amber-900',
                ]}
              >
                {t(locale, 'admin.dashboardCards.stockLeft', { count: variant.stock })}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <div class="mt-6 flex flex-wrap gap-3">
    <a
      href="/admin/products/new"
      class="rounded border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-50"
    >
      {t(locale, 'admin.product.new')}
    </a>
    <a
      href="/admin/categories"
      class="rounded border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-50"
    >
      {t(locale, 'admin.category.new')}
    </a>
    <button
      id="reindex-search"
      type="button"
      class="rounded border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-50 disabled:opacity-60"
      data-running={t(locale, 'admin.reindex.running')}
      data-done={t(locale, 'admin.reindex.done')}
      data-failed={t(locale, 'admin.reindex.failed')}
    >
      {t(locale, 'admin.reindex.action')}
    </button>
  </div>
  <p id="reindex-status" class="mt-2 hidden text-sm" aria-live="polite"></p>
</AdminLayout>

<script>
  import { adminErrorMessage } from '../../scripts/admin-errors';

  const button = document.getElementById('reindex-search') as HTMLButtonElement | null;
  const status = document.getElementById('reindex-status');

  button?.addEventListener('click', async () => {
    button.disabled = true;
    if (status) {
      status.textContent = button.dataset.running ?? '';
      status.className = 'mt-2 text-sm text-slate-600';
    }

    try {
      const response = await fetch('/api/admin/search/reindex', {
        method: 'POST',
        credentials: 'same-origin',
      });
      const payload = (await response.json().catch(() => null)) as {
        ok?: boolean;
        data?: { products: number };
        error?: { code?: string };
      } | null;

      if (!response.ok || !payload?.ok) {
        if (status) {
          status.textContent = adminErrorMessage(
            payload?.error?.code,
            button.dataset.failed ?? '',
          );
          status.className = 'mt-2 text-sm text-rose-700';
        }
        return;
      }

      if (status) {
        status.textContent = (button.dataset.done ?? '').replace(
          '{count}',
          String(payload.data?.products ?? 0),
        );
        status.className = 'mt-2 text-sm text-emerald-700';
      }
    } catch {
      if (status) {
        status.textContent = button.dataset.failed ?? '';
        status.className = 'mt-2 text-sm text-rose-700';
      }
    } finally {
      button.disabled = false;
    }
  });
</script>
