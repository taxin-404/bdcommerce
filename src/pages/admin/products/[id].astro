---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminProductForm from '../../../components/AdminProductForm.astro';
import { resolveAdminLocale } from '../../../lib/admin-locale';
import { t } from '../../../lib/i18n';

const requested = Astro.url.searchParams.get('lang');
if (requested === 'bn' || requested === 'en') {
  Astro.cookies.set('admin_locale', requested, {
    path: '/',
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
  });
}
const locale = resolveAdminLocale(requested, Astro.cookies.get('admin_locale')?.value);

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/admin/products');

type ProductRow = {
  id: number;
  slug: string;
  title: string;
  title_bn: string | null;
  description: string | null;
  description_bn: string | null;
  category_id: number | null;
  price: number;
  compare_at_price: number | null;
  status: 'draft' | 'active' | 'archived';
  track_stock: number;
  attributes: string | null;
  featured: number;
};

const row = await env.DB.prepare('SELECT * FROM products WHERE id = ?')
  .bind(id)
  .first<ProductRow>();

if (!row) return Astro.redirect('/admin/products');

const { results: variantRows } = await env.DB.prepare(
  'SELECT id, sku, title, options, price, stock, active FROM variants WHERE product_id = ? ORDER BY id',
)
  .bind(id)
  .all<{
    id: number;
    sku: string | null;
    title: string;
    options: string | null;
    price: number | null;
    stock: number;
    active: number;
  }>();

const { results: imageRows } = await env.DB.prepare(
  'SELECT id, r2_key, alt, sort FROM product_images WHERE product_id = ? ORDER BY sort, id',
)
  .bind(id)
  .all<{ id: number; r2_key: string; alt: string | null; sort: number }>();

const { results: categories } = await env.DB.prepare(
  'SELECT id, name FROM categories ORDER BY sort, id',
).all<{ id: number; name: string }>();

function parseJson(value: string | null): Record<string, string> {
  if (!value) return {};
  try {
    const parsed = JSON.parse(value) as unknown;
    if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) return {};
    return Object.fromEntries(
      Object.entries(parsed as Record<string, unknown>).map(([key, item]) => [key, String(item)]),
    );
  } catch {
    return {};
  }
}

const product = {
  ...row,
  track_stock: row.track_stock === 1,
  featured: row.featured === 1,
  attributes: parseJson(row.attributes),
  variants: variantRows.map((variant) => ({
    ...variant,
    options: parseJson(variant.options),
    active: variant.active === 1,
  })),
  images: imageRows,
};
---

<AdminLayout title={row.title} locale={locale} current="product">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">{row.title}</h1>
      <p class="text-sm text-slate-500">#{row.id} · {row.slug}</p>
    </div>
    <a href="/admin/products" class="text-sm text-slate-600 hover:text-slate-900">
      {t(locale, 'admin.product.backToList')}
    </a>
  </div>

  <AdminProductForm locale={locale} product={product} categories={categories} />
</AdminLayout>
