---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { resolveAdminLocale } from '../../lib/admin-locale';
import { formatDhakaDateTime } from '../../lib/datetime';
import { formatBdt } from '../../lib/money';
import { t } from '../../lib/i18n';
import { countRoundTrips, logQueryCount } from '../../lib/query-log';
import { loadConfig } from '../../lib/config';

const requested = Astro.url.searchParams.get('lang');
if (requested === 'bn' || requested === 'en') {
  Astro.cookies.set('admin_locale', requested, {
    path: '/',
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
  });
}
const locale = resolveAdminLocale(requested, Astro.cookies.get('admin_locale')?.value);

const { value: db, count } = countRoundTrips(env.DB);
const [couponsResult, config] = await Promise.all([
  db
    .prepare(
      `SELECT code, type, value, min_subtotal, max_uses, used, starts_at, ends_at, active
         FROM coupons ORDER BY code`,
    )
    .all<{
      code: string;
      type: 'percent' | 'fixed';
      value: number;
      min_subtotal: number;
      max_uses: number | null;
      used: number;
      starts_at: string | null;
      ends_at: string | null;
      active: number;
    }>(),
  loadConfig(db),
]);
logQueryCount('admin/coupons', count());

const coupons = couponsResult.results;
const money = (amount: number) =>
  formatBdt(amount, {
    locale,
    symbol: config.currency.symbol,
    bnDigits: config.currency.bnDigits,
  });
const couponValue = (type: string, value: number) =>
  type === 'percent' ? `${value}%` : money(value);
const dhakaDateInput = (iso: string | null): string => {
  if (!iso) return '';
  const time = Date.parse(iso);
  if (Number.isNaN(time)) return '';
  return new Date(time + 6 * 60 * 60 * 1000).toISOString().slice(0, 10);
};
const couponEditJson = (coupon: (typeof coupons)[number]) =>
  JSON.stringify({
    code: coupon.code,
    type: coupon.type,
    value: coupon.value,
    min_subtotal: coupon.min_subtotal,
    max_uses: coupon.max_uses,
    used: coupon.used,
    starts_at: dhakaDateInput(coupon.starts_at),
    ends_at: dhakaDateInput(coupon.ends_at),
    active: Boolean(coupon.active),
  }).replace(/</g, '\\u003c');
const inputClass =
  'w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-200';
---

<AdminLayout title={t(locale, 'admin.coupons')} locale={locale} current="coupons">
  <div class="mb-5">
    <h1 class="text-2xl font-semibold">{t(locale, 'admin.coupons')}</h1>
    <p class="mt-1 text-sm text-slate-500">{t(locale, 'admin.coupon.hint')}</p>
  </div>

  <form
    id="coupon-form"
    class="rounded-xl bg-white p-4 shadow-sm"
    data-failed={t(locale, 'admin.coupon.saveFailed')}
  >
    <h2 class="text-lg font-semibold">{t(locale, 'admin.coupon.new')}</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.code')}</span>
        <input name="code" required maxlength="32" class={inputClass} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.type')}</span>
        <select name="type" class={inputClass}>
          <option value="percent">{t(locale, 'admin.coupon.percent')}</option>
          <option value="fixed">{t(locale, 'admin.coupon.fixed')}</option>
        </select>
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.value')}</span>
        <input name="value" type="number" min="1" required class={inputClass} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.minSubtotal')}</span>
        <input name="min_subtotal" type="number" min="0" value="0" class={inputClass} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.maxUses')}</span>
        <input name="max_uses" type="number" min="1" class={inputClass} />
      </label>
      <label class="flex items-end gap-2 pb-2 text-sm">
        <input name="active" type="checkbox" checked />
        <span>{t(locale, 'admin.coupon.active')}</span>
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.starts')}</span>
        <input name="starts_at" type="date" class={inputClass} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.ends')}</span>
        <input name="ends_at" type="date" class={inputClass} />
      </label>
    </div>
    <button
      type="submit"
      class="mt-4 rounded bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800"
    >
      {t(locale, 'admin.coupon.create')}
    </button>
    <p id="coupon-status" class="mt-2 hidden text-sm" aria-live="polite"></p>
  </form>

  <section class="mt-4 overflow-x-auto rounded-xl bg-white shadow-sm">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2">{t(locale, 'admin.coupon.code')}</th>
          <th class="px-3 py-2">{t(locale, 'admin.coupon.value')}</th>
          <th class="px-3 py-2">{t(locale, 'admin.coupon.minSubtotal')}</th>
          <th class="px-3 py-2">{t(locale, 'admin.coupon.used')}</th>
          <th class="px-3 py-2">{t(locale, 'admin.coupon.window')}</th>
          <th class="px-3 py-2">{t(locale, 'admin.coupon.active')}</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {coupons.length === 0 && (
          <tr>
            <td colspan="7" class="px-3 py-6 text-center text-slate-500">
              {t(locale, 'admin.coupon.empty')}
            </td>
          </tr>
        )}
        {coupons.map((coupon) => (
          <tr>
            <td class="px-3 py-2 font-mono font-medium">{coupon.code}</td>
            <td class="px-3 py-2">{couponValue(coupon.type, coupon.value)}</td>
            <td class="px-3 py-2">{money(coupon.min_subtotal)}</td>
            <td class="px-3 py-2">
              {coupon.used}
              {coupon.max_uses !== null ? ` / ${coupon.max_uses}` : ''}
            </td>
            <td class="px-3 py-2 text-xs text-slate-500">
              {coupon.starts_at ? formatDhakaDateTime(coupon.starts_at, locale) : '—'}
              {' → '}
              {coupon.ends_at ? formatDhakaDateTime(coupon.ends_at, locale) : '—'}
            </td>
            <td class="px-3 py-2">
              <button
                type="button"
                class="js-coupon-toggle rounded px-2 py-1 text-xs font-medium"
                class:list={[
                  coupon.active ? 'bg-emerald-100 text-emerald-900' : 'bg-slate-200 text-slate-700',
                ]}
                data-code={coupon.code}
                data-active={coupon.active ? '1' : '0'}
                data-failed={t(locale, 'admin.coupon.toggleFailed')}
              >
                {coupon.active ? t(locale, 'common.yes') : t(locale, 'common.no')}
              </button>
            </td>
            <td class="px-3 py-2 text-right">
              <div class="flex flex-wrap justify-end gap-1">
                <button
                  type="button"
                  class="js-coupon-edit rounded border border-slate-300 px-2 py-1 text-xs hover:bg-slate-50"
                  data-coupon={couponEditJson(coupon)}
                >
                  {t(locale, 'admin.coupon.edit')}
                </button>
                <button
                  type="button"
                  class="js-coupon-delete rounded border border-rose-300 px-2 py-1 text-xs text-rose-700 hover:bg-rose-50"
                  data-code={coupon.code}
                  data-confirm={t(locale, 'admin.coupon.deleteConfirm')}
                  data-failed={t(locale, 'admin.coupon.deleteFailed')}
                >
                  {t(locale, 'admin.coupon.delete')}
                </button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <form
    id="coupon-edit-form"
    class="mt-4 hidden rounded-xl bg-white p-4 shadow-sm"
    data-failed={t(locale, 'admin.coupon.saveFailed')}
    data-used-hint={t(locale, 'admin.coupon.maxUsesBelowUsed')}
  >
    <h2 class="text-lg font-semibold">{t(locale, 'admin.coupon.editTitle')}</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.code')}</span>
        <input name="code" readonly class={`${inputClass} bg-slate-50 font-mono`} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.type')}</span>
        <select name="type" class={inputClass}>
          <option value="percent">{t(locale, 'admin.coupon.percent')}</option>
          <option value="fixed">{t(locale, 'admin.coupon.fixed')}</option>
        </select>
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.value')}</span>
        <input name="value" type="number" min="1" required class={inputClass} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.minSubtotal')}</span>
        <input name="min_subtotal" type="number" min="0" class={inputClass} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.maxUses')}</span>
        <input name="max_uses" type="number" min="1" class={inputClass} />
      </label>
      <label class="flex items-end gap-2 pb-2 text-sm">
        <input name="active" type="checkbox" />
        <span>{t(locale, 'admin.coupon.active')}</span>
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.starts')}</span>
        <input name="starts_at" type="date" class={inputClass} />
      </label>
      <label class="text-sm">
        <span class="mb-1 block font-medium">{t(locale, 'admin.coupon.ends')}</span>
        <input name="ends_at" type="date" class={inputClass} />
      </label>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <button
        type="submit"
        class="rounded bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800"
      >
        {t(locale, 'admin.coupon.saveChanges')}
      </button>
      <button
        id="coupon-edit-cancel"
        type="button"
        class="rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50"
      >
        {t(locale, 'common.cancel')}
      </button>
    </div>
    <p id="coupon-edit-status" class="mt-2 hidden text-sm" aria-live="polite"></p>
  </form>
</AdminLayout>

<script>
  import '../../scripts/admin-coupons';
</script>
