---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveAdminLocale } from '../../../lib/admin-locale';
import {
  ADMIN_ORDERS_PAGE_SIZE,
  decodeOrderCursor,
  listAdminOrders,
  parseOrderListFilters,
} from '../../../lib/admin-orders';
import { loadConfig } from '../../../lib/config';
import { formatDhakaDateTime } from '../../../lib/datetime';
import { formatBdt } from '../../../lib/money';
import { ORDER_STATUSES } from '../../../lib/order-status';
import { t } from '../../../lib/i18n';
import { countRoundTrips, logQueryCount } from '../../../lib/query-log';

const requested = Astro.url.searchParams.get('lang');
if (requested === 'bn' || requested === 'en') {
  Astro.cookies.set('admin_locale', requested, {
    path: '/',
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
  });
}
const locale = resolveAdminLocale(requested, Astro.cookies.get('admin_locale')?.value);

const filters = parseOrderListFilters({
  status: Astro.url.searchParams.get('status'),
  phone: Astro.url.searchParams.get('phone'),
  from: Astro.url.searchParams.get('from'),
  to: Astro.url.searchParams.get('to'),
});
const cursor = decodeOrderCursor(Astro.url.searchParams.get('cursor'));

const { value: db, count } = countRoundTrips(env.DB);
const [{ orders, nextCursor }, config] = await Promise.all([
  listAdminOrders({ db, filters, cursor, limit: ADMIN_ORDERS_PAGE_SIZE }),
  loadConfig(db),
]);
logQueryCount('admin/orders', count());

const baseParams = new URLSearchParams();
if (filters.status) baseParams.set('status', filters.status);
if (filters.phone) baseParams.set('phone', filters.phone);
if (filters.fromDate) baseParams.set('from', filters.fromDate);
if (filters.toDate) baseParams.set('to', filters.toDate);

function pageHref(target: string | null): string {
  const params = new URLSearchParams(baseParams);
  if (target) params.set('cursor', target);
  const query = params.toString();
  return query ? `/admin/orders?${query}` : '/admin/orders';
}

const statusClass: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-900',
  confirmed: 'bg-sky-100 text-sky-900',
  shipped: 'bg-indigo-100 text-indigo-900',
  delivered: 'bg-emerald-100 text-emerald-900',
  cancelled: 'bg-slate-200 text-slate-700',
  returned: 'bg-rose-100 text-rose-900',
};
---

<AdminLayout title={t(locale, 'admin.orders')} locale={locale} current="orders">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">{t(locale, 'admin.orders')}</h1>
    {cursor && (
      <a
        href="/admin/orders"
        class="rounded border border-slate-300 bg-white px-3 py-2 text-sm hover:bg-slate-50"
      >
        {t(locale, 'admin.order.newest')}
      </a>
    )}
  </div>

  <form method="get" class="mb-4 rounded-xl bg-white p-4 shadow-sm">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block text-sm">
        <span class="mb-1 block text-slate-600">{t(locale, 'admin.order.status')}</span>
        <select
          name="status"
          class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-teal-600 focus:outline-none"
        >
          <option value="">{t(locale, 'admin.order.allStatuses')}</option>
          {
            ORDER_STATUSES.map((status) => (
              <option value={status} selected={filters.status === status}>
                {t(locale, `admin.order.statusLabel.${status}`)}
              </option>
            ))
          }
        </select>
      </label>

      <label class="block text-sm">
        <span class="mb-1 block text-slate-600">{t(locale, 'admin.order.phone')}</span>
        <input
          type="tel"
          name="phone"
          value={filters.phone ?? ''}
          inputmode="tel"
          autocomplete="off"
          placeholder={t(locale, 'admin.order.phonePlaceholder')}
          class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-teal-600 focus:outline-none"
        />
      </label>

      <label class="block text-sm">
        <span class="mb-1 block text-slate-600">{t(locale, 'admin.order.from')}</span>
        <input
          type="date"
          name="from"
          value={filters.fromDate ?? ''}
          class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-teal-600 focus:outline-none"
        />
      </label>

      <label class="block text-sm">
        <span class="mb-1 block text-slate-600">{t(locale, 'admin.order.to')}</span>
        <input
          type="date"
          name="to"
          value={filters.toDate ?? ''}
          class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-teal-600 focus:outline-none"
        />
      </label>
    </div>

    <p class="mt-2 text-xs text-slate-500">{t(locale, 'admin.order.dateHint')}</p>

    <div class="mt-3 flex gap-2">
      <button
        type="submit"
        class="rounded bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800"
      >
        {t(locale, 'admin.order.filter')}
      </button>
      <a
        href="/admin/orders"
        class="rounded border border-slate-300 bg-white px-4 py-2 text-sm hover:bg-slate-50"
      >
        {t(locale, 'admin.order.clear')}
      </a>
    </div>
  </form>

  {
    filters.errors.length > 0 && (
      <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
        {filters.errors.map((error) => (
          <p>{t(locale, `admin.order.filterErrors.${error}`)}</p>
        ))}
      </div>
    )
  }

  <section class="space-y-2">
    {
      orders.length === 0 ? (
        <p class="rounded-xl bg-white p-6 text-center text-slate-500 shadow-sm">
          {t(locale, 'admin.order.empty')}
        </p>
      ) : (
        orders.map((order) => (
          <a
            href={`/admin/orders/${order.id}`}
            class="block rounded-xl bg-white p-4 shadow-sm transition hover:shadow"
          >
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <span class="font-mono text-sm font-semibold">{order.number}</span>
                <span class="ml-2 text-sm text-slate-600">{order.customer_name}</span>
                <span class="block text-xs text-slate-500">{order.phone}</span>
              </div>
              <div class="text-right">
                <span
                  class:list={[
                    'inline-block rounded-full px-2 py-0.5 text-xs font-medium',
                    statusClass[order.status] ?? 'bg-slate-100 text-slate-700',
                  ]}
                >
                  {t(locale, `admin.order.statusLabel.${order.status}`)}
                </span>
                <span class="mt-1 block text-sm font-semibold">
                  {formatBdt(order.total, {
                    locale,
                    symbol: config.currency.symbol,
                    bnDigits: config.currency.bnDigits,
                  })}
                </span>
              </div>
            </div>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
              <span>{formatDhakaDateTime(order.created_at, locale)}</span>
              <span>{t(locale, `admin.order.payment.${order.payment_method}`)}</span>
              <span>{t(locale, `admin.order.paymentStatus.${order.payment_status}`)}</span>
            </div>
          </a>
        ))
      )
    }
  </section>

  {
    nextCursor && (
      <div class="mt-4 flex justify-center">
        <a
          href={pageHref(nextCursor)}
          class="rounded border border-slate-300 bg-white px-4 py-2 text-sm hover:bg-slate-50"
        >
          {t(locale, 'admin.order.next')}
        </a>
      </div>
    )
  }
</AdminLayout>
