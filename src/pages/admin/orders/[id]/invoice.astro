---
import { env } from 'cloudflare:workers';
import PrintLayout from '../../../../layouts/PrintLayout.astro';
import { resolveAdminLocale } from '../../../../lib/admin-locale';
import { loadOrderForPrint } from '../../../../lib/admin-order-detail';
import { loadConfig } from '../../../../lib/config';
import { formatDhakaDateTime } from '../../../../lib/datetime';
import { formatBdt } from '../../../../lib/money';
import { t } from '../../../../lib/i18n';
import { countRoundTrips, logQueryCount } from '../../../../lib/query-log';

const requested = Astro.url.searchParams.get('lang');
if (requested === 'bn' || requested === 'en') {
  Astro.cookies.set('admin_locale', requested, {
    path: '/',
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
  });
}
const locale = resolveAdminLocale(requested, Astro.cookies.get('admin_locale')?.value);
const id = Number(Astro.params.id);
const validId = Number.isSafeInteger(id) && id > 0;

const { value: db, count } = countRoundTrips(env.DB);
const [data, config] = await Promise.all([
  validId ? loadOrderForPrint(db, id) : Promise.resolve(null),
  loadConfig(db),
]);
logQueryCount('admin/orders/[id]/invoice', count());

if (!data) Astro.response.status = 404;
const order = data?.order ?? null;
const items = data?.items ?? [];
const money = (amount: number) =>
  formatBdt(amount, {
    locale,
    symbol: config.currency.symbol,
    bnDigits: config.currency.bnDigits,
  });
---

<PrintLayout
  title={order ? `${t(locale, 'admin.print.invoice')} ${order.number}` : t(locale, 'admin.order.notFoundTitle')}
  locale={locale}
  orderId={order?.id ?? 0}
>
  {
    !order ? (
      <p class="py-10 text-center text-slate-500">{t(locale, 'admin.order.notFound')}</p>
    ) : (
      <article>
        <header class="flex flex-wrap items-start justify-between gap-6 border-b border-slate-200 pb-4">
          <div>
            <h1 class="text-xl font-bold">{config.name[locale]}</h1>
            <p class="mt-1 text-xs text-slate-600">{config.contact.address[locale]}</p>
            <p class="text-xs text-slate-600">{config.contact.phone}</p>
            <p class="text-xs text-slate-600">{config.contact.email}</p>
          </div>
          <div class="text-right">
            <h2 class="text-lg font-semibold">{t(locale, 'admin.print.invoice')}</h2>
            <p class="font-mono text-sm">{order.number}</p>
            <p class="text-xs text-slate-600">{formatDhakaDateTime(order.created_at, locale)}</p>
            <p class="text-xs text-slate-600">
              {t(locale, `admin.order.payment.${order.payment_method}`)} ·
              {t(locale, `admin.order.paymentStatus.${order.payment_status}`)}
            </p>
          </div>
        </header>

        <section class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <h3 class="text-xs font-semibold uppercase text-slate-500">
              {t(locale, 'admin.print.billTo')}
            </h3>
            <p class="mt-1 font-medium">{order.customer_name}</p>
            <p class="text-sm">{order.phone}</p>
            {order.email && <p class="break-all text-sm">{order.email}</p>}
          </div>
          <div>
            <h3 class="text-xs font-semibold uppercase text-slate-500">
              {t(locale, 'admin.print.deliverTo')}
            </h3>
            <p class="mt-1 text-sm">
              {[order.address, order.upazila, order.district, order.division]
                .filter(Boolean)
                .join(', ')}
            </p>
          </div>
        </section>

        <table class="mt-6 w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-300 text-xs uppercase text-slate-500">
              <th class="py-2 pr-2">{t(locale, 'admin.print.item')}</th>
              <th class="py-2 px-2 text-right">{t(locale, 'admin.order.qty')}</th>
              <th class="py-2 px-2 text-right">{t(locale, 'admin.print.unitPrice')}</th>
              <th class="py-2 pl-2 text-right">{t(locale, 'admin.print.lineTotal')}</th>
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr class="border-b border-slate-100 align-top">
                <td class="py-2 pr-2">
                  <span class="font-medium">{item.title_snapshot}</span>
                  {item.variant_snapshot && (
                    <span class="block text-xs text-slate-500">{item.variant_snapshot}</span>
                  )}
                </td>
                <td class="py-2 px-2 text-right">{item.qty}</td>
                <td class="py-2 px-2 text-right">{money(item.unit_price)}</td>
                <td class="py-2 pl-2 text-right">{money(item.line_total)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <section class="mt-4 ml-auto max-w-xs space-y-1 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-500">{t(locale, 'admin.order.subtotal')}</span>
            <span>{money(order.subtotal)}</span>
          </div>
          {order.discount > 0 && (
            <div class="flex justify-between">
              <span class="text-slate-500">{t(locale, 'admin.order.discount')}</span>
              <span>−{money(order.discount)}</span>
            </div>
          )}
          <div class="flex justify-between">
            <span class="text-slate-500">{t(locale, 'admin.order.shipping')}</span>
            <span>{money(order.shipping_fee)}</span>
          </div>
          <div class="flex justify-between border-t border-slate-300 pt-1 text-base font-semibold">
            <span>{t(locale, 'admin.order.total')}</span>
            <span>{money(order.total)}</span>
          </div>
        </section>

        {order.note && (
          <p class="mt-6 rounded border border-slate-200 p-3 text-sm">
            <span class="font-medium">{t(locale, 'admin.order.note')}:</span> {order.note}
          </p>
        )}

        <p class="mt-8 text-center text-xs text-slate-500">{t(locale, 'admin.print.thanks')}</p>
      </article>
    )
  }
</PrintLayout>
