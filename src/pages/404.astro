---
import { env } from 'cloudflare:workers';
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
import { t } from '../lib/i18n';
import { resolveLocale } from '../lib/locale';
import { loadStorefront } from '../lib/storefront';

const { config } = await loadStorefront(env.DB);
const locale = resolveLocale(
  config.locale.default,
  config.locale.available,
  null,
  Astro.cookies.get('locale')?.value,
);
---

<StorefrontLayout
  title={`${t(locale, 'storefront.notFoundTitle')} · ${config.name[locale] || config.name.en}`}
  locale={locale}
  config={config}
>
  <div class="card mx-auto max-w-lg px-6 py-12 text-center">
    <h1 class="text-2xl font-semibold">{t(locale, 'storefront.notFoundTitle')}</h1>
    <p class="text-muted mt-2 text-sm">{t(locale, 'storefront.notFoundText')}</p>
    <a href="/shop" class="btn-primary mt-5 inline-block px-4 py-2 text-sm">
      {t(locale, 'storefront.allProducts')}
    </a>
  </div>
</StorefrontLayout>
