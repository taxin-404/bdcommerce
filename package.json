{
  "name": "bdcommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "pnpm types && astro check",
    "test": "vitest run",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "node scripts/seed.ts",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "postinstall": "pnpm types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/preact": "^6.1.6",
    "@hono/zod-validator": "^0.9.1",
    "astro": "^7.4.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
