{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bdcommerce",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  // R2_PUBLIC_URL is deliberately not declared here. It is optional and must
  // be set only after enabling R2 public access (r2.dev or a custom domain).
  // Declaring it as an empty var makes the Deploy to Cloudflare button ask for
  // a value during setup. Set it later in the Worker settings or in this file.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bdcommerce-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "bdcommerce-images"
    }
  ]
}
