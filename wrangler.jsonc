{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bdcommerce",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Optional. Set to a public R2 bucket or custom domain to serve images
    // without using Worker requests. Empty means the /img/* fallback is used.
    "R2_PUBLIC_URL": ""
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bdcommerce-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "bdcommerce-images"
    }
  ]
}
