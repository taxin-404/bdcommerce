{
  "name": "@bd/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:local": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply": "wrangler d1 migrations apply bdcommerce --local",
    "db:apply:remote": "wrangler d1 migrations apply bdcommerce --remote",
    "db:seed": "wrangler d1 execute bdcommerce --local --command=\"SELECT 'Seed is applied via migration 0001_seed.sql'\""
  },
  "dependencies": {
    "@bd/core": "1.0.0",
    "@bd/db": "1.0.0",
    "@hono/zod-validator": "^0.4.1",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
